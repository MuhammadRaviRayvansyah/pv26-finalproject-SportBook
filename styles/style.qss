/* Styling untuk Card Container */
#authCard, #loginCard {
    background-color: #FFFFFF;
    border-radius: 16px;
    border: none;
}

/* Typography Header */
#titleLabel {
    font-size: 26px;
    font-weight: bold;
    color: #000000;
    font-family: "Segoe UI", "Inter", sans-serif;
    margin-bottom: 5px;
}

#subtitleLabel {
    font-size: 14px;
    color: #71717A;
    font-family: "Segoe UI", "Inter", sans-serif;
}

/* Form Label */
#fieldLabel {
    font-size: 14px;
    font-weight: 600;
    color: #000000;
    font-family: "Segoe UI", "Inter", sans-serif;
}

/* Form Input Field */
QLineEdit {
    border: 1.5px solid #D4D4D8;
    border-radius: 10px;
    padding: 0px 15px;
    font-size: 14px;
    background-color: #FFFFFF;
    color: #000000;
}

QLineEdit:focus {
    border: 1.5px solid #22C55E;
}

QLineEdit::placeholder {
    color: #A1A1AA;
    font-weight: bold;
}

/* Button Submit (Masuk / Daftar) */
#btnSubmit, #btnMasuk {
    background-color: #22C55E;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    border-radius: 12px;
    border: none;
    font-family: "Segoe UI", "Inter", sans-serif;
}

#btnSubmit:hover, #btnMasuk:hover {
    background-color: #16A34A;
}

#btnSubmit:pressed, #btnMasuk:pressed {
    background-color: #15803D;
}

/* Footer Section */
#footerText {
    color: #71717A;
    font-size: 13px;
    font-weight: 600;
}

#footerLink {
    background: transparent;
    border: none;
    color: #22C55E;
    font-size: 13px;
    font-weight: bold;
    padding: 0;
    margin: 0;
}

#footerLink:hover {
    color: #16A34A;
    text-decoration: underline;
}

/* --- Penambahan Warna Background F5F5F5 --- */
#homePage, #contentScroll, #scrollContent {
    background-color: #F5F5F5;
}

#topNav, #botNav {
    background-color: #FFFFFF;
}

/* Beranda Styles */
#topNav {
    background-color: white;
    border-bottom: 1px solid #E5E7EB;
}

#userName {
    font-size: 15px;
    font-weight: 600;
    color: #111827;
    font-family: "Segoe UI", sans-serif;
}

/* Background image dihapus karena sudah di-handle oleh PaintEvent pada HeroFrame */
#heroSection {
    border-radius: 24px;
}

#heroTitle { 
    color: white; 
    font-size: 28px; 
    font-family: "Segoe UI", sans-serif;
}

#heroSub { 
    color: white; 
    font-size: 18px; 
    font-weight: 600; 
    font-family: "Segoe UI", sans-serif;
}

#heroSubSmall { 
    color: white; 
    font-size: 14px;
    font-weight: normal;
    font-family: "Segoe UI", sans-serif;
    margin-bottom: 5px;
}

/* Badge Lokasi dengan Hover */
#locBadge {
    background-color: #22C55E;
    color: white;
    border-radius: 16px;
    font-size: 13px;
    font-weight: bold;
    border: none;
    padding: 5px 10px;
    font-family: "Segoe UI", sans-serif;
}

#locBadge:hover {
    background-color: #16A34A;
}

/* Tombol Booking Shape 1 dengan Hover */
#btnHero {
    background-color: white;
    color: #22C55E;
    border-radius: 21px;
    font-weight: bold;
    font-size: 14px;
    border: none;
    font-family: "Segoe UI", sans-serif;
}

#btnHero:hover {
    background-color: #F0FDF4;
    color: #16A34A;
}

/* Card Lapangan Styles */
#fieldCard {
    background-color: white;
    border-radius: 20px;
    border: none;
}

#cardTitle {
    font-size: 22px;
    font-weight: bold;
    color: #111827;
    font-family: "Segoe UI", sans-serif;
    margin: 0px;
    padding: 0px;
}

#cardDesc {
    font-size: 14px;
    font-family: "Segoe UI", sans-serif;
    margin: 0px;
    padding: 0px;
}

#cardPrice {
    font-size: 18px;
    font-weight: bold;
    color: #22C55E;
    font-family: "Segoe UI", sans-serif;
    margin: 0px;
    padding: 0px;
}

/* Tombol Booking Shape 2,3,4 dengan Hover */
#btnCardAction {
    background-color: #BBF7D0;
    color: #16A34A;
    border-radius: 12px;
    font-weight: bold;
    font-size: 14px;
    border: none;
    font-family: "Segoe UI", sans-serif;
}

#btnCardAction:hover {
    background-color: #86EFAC;
    color: #15803D;
}

/* Bottom Nav dengan Hover */
#botNav {
    background-color: white;
    border-top: none;
}

#btnNav, #btnNavActive {
    background: transparent;
    border: none;
    padding: 8px;
    border-radius: 8px;
    font-size: 12px;
    font-family: "Segoe UI", sans-serif;
}

#btnNav:hover, #btnNavActive:hover {
    background-color: #F3F4F6;
}

QToolButton {
    icon-size: 28px;
}

/* --- Penambahan Style Khusus Booking Page --- */

#topTitle {
    font-size: 20px;
    font-weight: bold;
    color: #111827;
    font-family: "Segoe UI", "Inter", sans-serif;
}

#btnBack {
    background: transparent;
    border: none;
    font-size: 24px;
    font-weight: bold;
    color: #111827;
    padding: 0px 10px;
    font-family: "Segoe UI", sans-serif;
}

#btnBack:hover {
    color: #22C55E;
}

/* Styling untuk Judul Section (List Lapangan) */
#sectionTitle {
    font-size: 20px;
    font-weight: bold;
    color: #111827;
    font-family: "Segoe UI", "Inter", sans-serif;
    margin-top: 10px;
    padding-bottom: 5px;
}

/* --- DETAIL BOOKING STYLES --- */
#detailCard {
    background-color: white;
    border-radius: 20px;
    border: none;
}

#detailNama {
    font-size: 26px;
    font-weight: bold;
    color: #111827;
    font-family: "Segoe UI", sans-serif;
    margin-top: 5px;
}

#detailTextBold {
    font-size: 14px;
    font-weight: bold;
    color: #111827;
    font-family: "Segoe UI", sans-serif;
}

#detailTextGreen {
    font-size: 14px;
    font-weight: bold;
    color: #26BF6C;
    font-family: "Segoe UI", sans-serif;
    margin-left: 10px;
}

#detailHarga {
    font-size: 28px;
    font-weight: bold;
    color: #26BF6C;
    font-family: "Segoe UI", sans-serif;
}

/* Tombol Jadwal (Grid) dengan 3 Status */
#slotBtn {
    border: none;
    font-size: 13px;
    font-family: "Segoe UI", sans-serif;
}

#slotBtn[state="available"] {
    background-color: #00FF74;
    color: #111827;
    border-radius: 17px;
    font-weight: bold;
}

#slotBtn[state="selected"] {
    background-color: #26BF6C;
    color: white;
    border-radius: 17px;
    font-weight: bold;
}

#slotBtn[state="booked"] {
    background-color: #F5F5F5;
    color: #A1A1AA;
    border-radius: 17px;
    font-weight: bold;
}

#durasiBadge {
    color: #26BF6C;
    border: 1.5px solid #26BF6C;
    border-radius: 14px;
    padding: 4px 15px;
    font-weight: bold;
    font-size: 14px;
    font-family: "Segoe UI", sans-serif;
}

#btnSubmitGreen {
    background-color: #26BF6C;
    color: white;
    border-radius: 15px;
    font-weight: bold;
    font-size: 16px;
    font-family: "Segoe UI", sans-serif;
    border: none;
}

#btnSubmitGreen:hover {
    background-color: #20A35B;
}