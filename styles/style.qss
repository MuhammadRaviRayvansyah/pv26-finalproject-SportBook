/* Styling untuk Card Container */
#authCard, #loginCard {
    background-color: #FFFFFF;
    border-radius: 16px;
    border: none;
}

/* Typography Header */
#titleLabel {
    font-size: 26px;
    font-weight: bold;
    color: #000000;
    margin-bottom: 5px;
}

#subtitleLabel {
    font-size: 14px;
    color: #71717A;
}

/* Form Label */
#fieldLabel {
    font-size: 14px;
    font-weight: 600;
    color: #000000;
}

/* Form Input Field */
QLineEdit {
    border: 1.5px solid #D4D4D8;
    border-radius: 10px;
    padding: 0px 15px;
    font-size: 14px;
    background-color: #FFFFFF;
    color: #000000;
}

QLineEdit:focus {
    border: 1.5px solid #22C55E;
}

QLineEdit::placeholder {
    color: #A1A1AA;
    font-weight: bold;
}

/* Button Submit (Masuk / Daftar) */
#btnSubmit, #btnMasuk {
    background-color: #22C55E;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    border-radius: 12px;
    border: none;
}

#btnSubmit:hover, #btnMasuk:hover {
    background-color: #16A34A;
}

#btnSubmit:pressed, #btnMasuk:pressed {
    background-color: #15803D;
}

/* Footer Section */
#footerText {
    color: #71717A;
    font-size: 13px;
    font-weight: 600;
}

#footerLink {
    background: transparent;
    border: none;
    color: #22C55E;
    font-size: 13px;
    font-weight: bold;
    padding: 0;
    margin: 0;
}

#footerLink:hover {
    color: #16A34A;
    text-decoration: underline;
}

/* --- Penambahan Warna Background F5F5F5 --- */
#scrollContent, #contentScroll{
    background-color: #F5F5F5;
}

#topNav, #botNav{
    background-color: #FFFFFF;
}

/* Beranda Styles */
#topNav {
    background-color: white;
    border-bottom: 1px solid #E5E7EB;
}

#userName {
    font-size: 15px;
    font-weight: 600;
    color: #111827;
}

/* Background image dihapus karena sudah di-handle oleh PaintEvent pada HeroFrame */
#heroTitle { 
    font-weight: bold;
    color: white; 
    font-size: 28px; 
}

#heroSub { 
    color: white; 
    font-size: 18px; 
    font-weight: bold; 
}

#heroSubSmall { 
    color: white; 
    font-size: 14px;
    font-weight: normal;
    margin-bottom: 5px;
}

/* Badge Lokasi dengan Hover */
#locBadge {
    background-color: #22C55E;
    color: white;
    border-radius: 16px;
    font-size: 13px;
    font-weight: bold;
}

#locBadge:hover {
    background-color: #16A34A;
}

/* Tombol Booking Shape 1 dengan Hover */
#btnHero {
    background-color: white;
    color: #22C55E;
    border-radius: 21px;
    font-weight: bold;
    font-size: 14px;
}

#btnHero:hover {
    background-color: #F0FDF4;
    color: #16A34A;
}

/* Card Lapangan Styles */
#fieldCard {
    background-color: white;
    border-radius: 20px;
}

#cardTitle {
    font-size: 22px;
    font-weight: bold;
    color: #111827;
}

#priceLabel {
    font-size: 14px;
    color: #000000; 
    font-weight: bold;
}

#cardPrice {
    font-size: 18px;
    font-weight: bold;
    color: #22C55E;
    margin: 0px;
    padding: 0px;
}

/* Tombol Booking dengan Hover */
#btnCardAction {
    background-color: #BBF7D0;
    color: #16A34A;
    border-radius: 12px;
    font-weight: bold;
    font-size: 14px;
}

#btnCardAction:hover {
    background-color: #86EFAC;
    color: #15803D;
}

/* Bottom Nav dengan Hover */
#botNav {
    background-color: white;
    border-top: none;
}

#btnNav, #btnNavActive {
    background: transparent;
    border: none;
    padding: 8px;
    border-radius: 8px;
    font-size: 12px;
}

#btnNav:hover, #btnNavActive:hover {
    background-color: #F3F4F6;
}

QToolButton {
    icon-size: 28px;
}

/* --- Penambahan Style Khusus Booking Page --- */

#topTitle {
    font-size: 20px;
    font-weight: bold;
    color: #111827;
}

#btnBack {
    background: transparent;
    border: none;
    font-size: 24px;
    font-weight: bold;
    color: #111827;
    padding: 0px 10px;
}

#btnBack:hover {
    color: #22C55E;
}

/* Styling untuk Judul Section (List Lapangan) */
#sectionTitle {
    font-size: 20px;
    font-weight: bold;
    color: #111827;
    margin-top: 10px;
    padding-bottom: 5px;
}

/* --- DETAIL BOOKING STYLES --- */
#detailCard {
    background-color: white;
    border-radius: 20px;
}

#detailNama {
    font-size: 26px;
    font-weight: bold;
    color: #111827;
    margin-top: 5px;
}

#detailTextBold {
    font-size: 14px;
    font-weight: bold;
    color: #111827;
}

#detailTextGreen {
    font-size: 14px;
    font-weight: bold;
    color: #26BF6C;
    margin-left: 10px;
}

#detailHarga {
    font-size: 28px;
    font-weight: bold;
    color: #26BF6C;
}

/* Tombol Jadwal (Grid) dengan 3 Status */
#slotBtn {
    font-size: 13px;
}

#slotBtn[state="available"] {
    background-color: #00FF74;
    color: #111827;
    border-radius: 17px;
    font-weight: bold;
}

#slotBtn[state="selected"] {
    background-color: #26BF6C;
    color: white;
    border-radius: 17px;
    font-weight: bold;
}

#slotBtn[state="booked"] {
    background-color: #F5F5F5;
    color: #A1A1AA;
    border-radius: 17px;
    font-weight: bold;
}

#durasiBadge {
    color: #26BF6C;
    border: 1.5px solid #26BF6C;
    border-radius: 14px;
    padding: 4px 15px;
    font-weight: bold;
    font-size: 14px;
}

#btnSubmitGreen {
    background-color: #26BF6C;
    color: white;
    border-radius: 15px;
    font-weight: bold;
    font-size: 16px;
    border: none;
}

#btnSubmitGreen:hover {
    background-color: #20A35B;
}

/* --- PEMBAYARAN STYLES --- */
#paymentCard {
    background-color: white;
    border-radius: 15px;
    border: none;
}

#paymentTitle {
    font-size: 20px;
    font-weight: bold;
    color: #000000;
}

/* Memperbesar ukuran Radio Button agar menyerupai referensi UI */
#paymentRadio::indicator {
    width: 24px;
    height: 24px;
    border-radius: 13px;
    border: 2px solid #111827;
}

#paymentRadio::indicator:checked {
    background-color: #000000;
    border: 6px solid white;
    outline: 2px solid #000000; /* Efek cincin luar */
}

#summaryLabel {
    font-size: 16px;
    font-weight: bold;
    color: #6B7280;
}

#summaryTotal {
    font-size: 26px;
    font-weight: bold;
    color: #26BF6C;
}

/* --- NOTIFIKASI SUKSES STYLES --- */
#notifTitle {
    font-size: 32px;
    font-weight: bold;
    color: #000000;
    line-height: 1.2;
}

#notifDesc {
    font-size: 18px;
    font-weight: 500;
    color: #000000;
    line-height: 1.4;
}

QFrame#historyCard {
    background-color: white;
    border-radius: 20px;
}

#tggl_book {
    font-weight: bold; 
    color: #000000;
}

#jam {
    font-weight: bold; 
    color: #000000;
}

#lbl {
    font-weight: bold; 
    color: #000000;
}

#btn_hps {
    color: #DC2626; 
    font-weight: bold; 
    font-size: 14px;
    background: transparent;
    text-align: left;
}

#btn_keluar {
    background-color: #EF4444; 
    color: white; 
    border-radius: 8px; 
    font-size: 15px;
    font-weight: bold; 
}

#btn_keluar:hover {
    background-color: #DC2626;
}

/* ComboBox tanggal */
QComboBox#dateCombo {
    border: 2px solid #D1D5DB;
    border-radius: 10px;
    padding: 5px 15px;
    font-size: 14px;
    font-weight: bold;
    background-color: white;
    color: #111827;
}

/* Area tombol panah */
QComboBox#dateCombo::drop-down {
    border: none;
    width: 30px;
}

/* Popup daftar item */
QComboBox#dateCombo QAbstractItemView {
    background-color: white;
    color: #111827;
    selection-background-color: #22C55E;
    selection-color: white;
    border: 1px solid #D1D5DB;
    outline: none;
}


/* Salin ini ke dalam file style.qss Anda */
QFrame#paymentCard {
    background-color: white;
    border-radius: 15px;
}

QFrame#paymentCard QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border-radius: 12px;
    border: 2px solid #111827;
    background-color: white;
    margin: 0px;
}

QFrame#paymentCard QRadioButton::indicator:checked {
    width: 20px;
    height: 20px;
    border-radius: 12px;
    border: 2px solid #111827;
    background-color: qradialgradient(
        cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, 
        stop:0 #111827, stop:0.45 #111827, 
        stop:0.55 white, stop:1 white
    );
}

/* Styling untuk Dialog Box Konfirmasi Pembayaran */
QMessageBox#pembayaranConfirmBox {
    background-color: #FFFFFF;
}

/* Styling Teks di dalam Dialog Box */
QMessageBox#pembayaranConfirmBox QLabel {
    color: #111827;
    font-size: 14px;
    font-weight: 500;
}

/* Styling untuk semua tombol di dalam Dialog Box Pembayaran */
QMessageBox#pembayaranConfirmBox QPushButton {
    background-color: #26BF6C;
    color: white;
    border-radius: 8px;
    font-weight: bold;
    font-size: 13px;
    min-width: 75px;
    min-height: 28px;
    border: none;
}

QMessageBox#pembayaranConfirmBox QPushButton:hover {
    background-color: #20A35B;
}

/* Khusus tombol 'Tidak' atau NoRole jika ingin diberikan warna berbeda (misal abu-ala/merah) */
QMessageBox#pembayaranConfirmBox QPushButton[text="Tidak"] {
    background-color: #EF4444;
}

QMessageBox#pembayaranConfirmBox QPushButton[text="Tidak"]:hover {
    background-color: #DC2626;
}